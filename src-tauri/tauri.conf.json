{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipCaption",
  "version": "0.1.2",
  "identifier": "com.clipcaption.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipCaption",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/whisper-cli",
      "binaries/sherpa-onnx-offline-speaker-diarization"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENkE1QjExNDc2N0FFQzEKUldUQnJtZEhFVnRxSGZLUXlCMWkyejB5TnNlMGhidXdVTTU5a0NkbEhtYkdGV2trK2FxRVFIeEEK",
      "endpoints": [
        "https://github.com/Chronox2290/clipcaption/releases/latest/download/latest.json"
      ]
    }
  }
}
